{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew test:*)",
      "Bash(./gradlew checkstyleMain:*)",
      "Bash(./gradlew checkstyleTest:*)",
      "Bash(./gradlew openapi3:*)",
      "Bash(./gradlew compileJava:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/application-local.yml)",
      "Read(./**/application-secret.yml)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-java.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
