# backend 환경변수 목록(#386). 로컬은 복사해서 backend/.env로 쓴다(커밋하지 않는다).
# 운영 값은 Parameter Store /moeun/prod/backend(공통 값은 /moeun/prod/shared)에만 둔다. docs/deploy.md
# 비어 있으면 application.yml 기본값을 쓴다.

# ===== DB (PostgreSQL + pgvector) =====
# 로컬 기본값은 루트 docker-compose.yml의 DB. 운영(RDS)은 jdbc:postgresql://<RDS 엔드포인트>:5432/moeun?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/moeun
DB_USERNAME=moeun
DB_PASSWORD=moeun

# ===== 스키마 초기화 =====
# 기동 시 db/schema.sql 실행 여부. always=매번 실행(IF NOT EXISTS라 안전), never=실행 안 함
SQL_INIT_MODE=always

# ===== 서버 =====
SERVER_PORT=8080
# local이면 Secure 쿠키를 끈다. 로컬 http 개발에서만 쓴다. 운영에서는 두지 않는다(deploy.sh가 막는다)
SPRING_PROFILES_ACTIVE=local

# ===== JWT =====
# HS256 서명 키. 32바이트 이상. 예: openssl rand -base64 48
JWT_SECRET=
# 기본 true. 운영에서 false 금지(deploy.sh가 막는다)
# JWT_COOKIE_SECURE=true

# 데모 계정 "id:비밀번호,id:비밀번호"
DEMO_ACCOUNTS=

# ===== AI 서버 연동 =====
AI_SERVER_URL=http://localhost:8000
# Spring ↔ ai-server 내부 호출용 키. ai-server의 INTERNAL_API_KEY와 같아야 한다(운영은 /moeun/prod/shared)
INTERNAL_API_KEY=local-internal-key

# ===== CORS =====
# 허용할 프론트 Origin(쉼표로 여러 개). 로컬은 Vite 기본 포트, 운영은 Vercel 주소
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== 로그 =====
LOG_DIR=logs
LOG_RETENTION_DAYS=7
