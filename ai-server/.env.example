# 복사해서 .env로 사용. .env는 커밋하지 않는다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DATABASE_URL=postgresql://moeun:moeun@localhost:5432/moeun
SPRING_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=local-internal-key   # Spring application.yml의 moeun.ai-server.internal-api-key와 같아야 한다

ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5

# 대화 로그(#316): 요청·답 본문까지 남기고 날짜별 파일을 이 일수만큼 보관한다. 0이면 파일을 쓰지 않는다
LOG_DIR=logs
LOG_RETENTION_DAYS=7

# 외부 추적(LangSmith)은 팀 결정 전까지 끈다. 사용자 발화와 계획 정보가 외부로 나간다.
LANGSMITH_TRACING=false
