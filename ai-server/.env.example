# 복사해서 쓰는 설정 템플릿. 복사본은 커밋하지 않는다(.gitignore).
# 값은 app/core/config.py의 Settings가 읽는다. 줄을 지우면 Settings의 기본값을 쓴다.

# --- 반드시 채울 것 -------------------------------------------------------
# 대화 생성(/chat). 없으면 /chat이 실패한다
ANTHROPIC_API_KEY=
# 임베딩 전용(/rag/search, 적재 CLI). 없으면 검색과 적재가 실패한다
OPENAI_API_KEY=

# --- 환경에 맞게 확인할 것 -------------------------------------------------
# PostgreSQL 16 + pgvector
DATABASE_URL=postgresql://moeun:moeun@localhost:5432/moeun
# /internal/calc를 가진 Spring 주소
SPRING_BASE_URL=http://localhost:8080
# Spring application.yml의 moeun.ai-server.internal-api-key와 같아야 한다
INTERNAL_API_KEY=local-internal-key

# --- 기본값 그대로 써도 되는 것 --------------------------------------------
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# 요청 한 건에서 모델을 부르는 최대 횟수
MAX_TOOL_ROUNDS=6
SPRING_TIMEOUT_SECONDS=10
# 바꾸면 chunk_embedding.model_code가 달라져 다시 적재해야 한다
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5

# 외부 추적(LangSmith)은 팀 결정 전까지 끈다. 사용자 발화와 계획 정보가 외부로 나간다.
# 서버와 테스트는 이 값과 무관하게 시작할 때 추적을 끈다(app/core/config.py force_tracing_off).
LANGSMITH_TRACING=false
