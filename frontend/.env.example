# 복사해서 .env.local로 쓴다(커밋하지 않는다).
# 브라우저는 /api/... 상대 경로만 부른다. 로컬은 Vite proxy가, 운영은 vercel.json rewrites가 백엔드로 넘긴다(#386)

# 로컬 Vite proxy가 /api를 넘길 Spring 주소(vite.config.ts). 기본값 http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:8080

# mock이면 백엔드 없이 목 데이터로 띄운다(src/mocks/README.md). 운영(Vercel)에는 두지 않는다
# VITE_API_MODE=mock
